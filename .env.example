# Docker Compose Project Name (prevents container collisions between prod and testing stacks)
# Prod: wvmap_prod  |  Testing: wvmap_testing
COMPOSE_PROJECT_NAME=wvmap_prod

# Express backend port (internal to container)
PORT=3000

# Node environment (development / production)
NODE_ENV=production

# Domains and CSP headers for Caddy
# Prod:
# WEB_DOMAINS=westville.app:80, www.westville.app:80
# MAP_DOMAINS=map.westville.app:80
# CSP_FRAME_ANCESTORS=https://map.westville.app https://www.westville.app https://westville.app
#
# Testing:
# WEB_DOMAINS=testing.westville.app:80
# MAP_DOMAINS=testing-map.westville.app:80
# CSP_FRAME_ANCESTORS=https://testing-map.westville.app https://testing.westville.app
WEB_DOMAINS=westville.app:80, www.westville.app:80
MAP_DOMAINS=map.westville.app:80
CSP_FRAME_ANCESTORS=https://map.westville.app https://www.westville.app https://westville.app

# Secure authorization token for writing/saving GeoJSON map data.
# This token must match the x-map-data-token header sent by the client (e.g., Google Apps Script)
# Generate a strong token (e.g., openssl rand -base64 48)
APPS_SCRIPT_TOKEN=your_secure_apps_script_token_here

# Cloudflare Tunnel Token
# Required by cloudflared container in compose.yaml to connect your local server to the internet
# Find this in your Cloudflare Zero Trust Dashboard -> Tunnels
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Local Deployment & Release Automation (used by ./push_and_reload and ./release)
DEPLOY_HOST=your_remote_server_host_here
GH_RELEASE_USER=your_github_username_here
STAGING_REMOTE_DIR=~/docker/westvillemap-testing
PROD_REMOTE_DIR=~/docker/westvillemap
