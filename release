#!/usr/bin/env bash
set -euo pipefail

# Helper to load config variables from local .env
get_env_var() {
  local var_name="$1"
  local default_val="${2:-}"
  if [[ -f .env ]]; then
    local val
    val=$(grep -E "^${var_name}=" .env | cut -d '=' -f2- | tr -d '"'\'' ' || true)
    if [[ -n "$val" ]]; then
      echo "$val"
      return
    fi
  fi
  echo "$default_val"
}

REMOTE_HOST=$(get_env_var "DEPLOY_HOST" "")
GH_USER=$(get_env_var "GH_RELEASE_USER" "")
PROD_DIR=$(get_env_var "PROD_REMOTE_DIR" "~/docker/westvillemap")
STAGING_DIR=$(get_env_var "STAGING_REMOTE_DIR" "~/docker/westvillemap-testing")

if [[ -z "$REMOTE_HOST" ]]; then
  echo "❌ Error: DEPLOY_HOST is not set." >&2
  echo "   Please create a .env file with DEPLOY_HOST=your_ssh_host" >&2
  exit 1
fi

# 1. Check working directory status
if ! git diff-index --quiet HEAD --; then
  echo "❌ Error: Working tree has uncommitted changes. Please commit or stash them first." >&2
  git status --short
  exit 1
fi

echo "🔄 Step 1/7: Fetching latest branches from GitHub..."
git fetch origin

# 2. Switch gh CLI account if configured and gh is present
if command -v gh >/dev/null 2>&1 && [[ -n "$GH_USER" ]]; then
  gh auth switch --hostname github.com --user "$GH_USER" 2>/dev/null || true
fi

# 3. Checkout main and pull latest
echo "🔄 Step 2/7: Checking out and updating 'main'..."
git checkout main
git pull origin main

# 4. Merge testing into main
echo "🔄 Step 3/7: Merging 'testing' branch into 'main'..."
git merge origin/testing -m "Merge branch 'testing' into main"

# 5. Compute new version tag (YYYY.MM.DD.N) in America/New_York
DATE_TAG=$(TZ="America/New_York" date +"%Y.%m.%d")
EXISTING_TAGS=$(git tag -l "v${DATE_TAG}.*" 2>/dev/null || true)

NEXT_POINT=1
if [[ -n "$EXISTING_TAGS" ]]; then
  for tag in $EXISTING_TAGS; do
    # Extract number after date
    point_num="${tag##*.}"
    if [[ "$point_num" =~ ^[0-9]+$ ]] && (( point_num >= NEXT_POINT )); then
      NEXT_POINT=$(( point_num + 1 ))
    fi
  done
fi

VERSION="${DATE_TAG}.${NEXT_POINT}"
TAG="v${VERSION}"
BUILD_DATE=$(TZ="America/New_York" date +"%Y-%m-%d %H:%M:%S %Z")
COMMIT_SHA=$(git rev-parse --short HEAD)

echo "🔖 Generating Release Version: ${TAG}"

# 6. Update version.json files
cat > www/version.json <<EOF
{
  "version": "$VERSION",
  "channel": "production",
  "buildDate": "$BUILD_DATE",
  "timezone": "America/New_York",
  "gitCommit": "$COMMIT_SHA"
}
EOF

cp www/version.json map/version.json

git add www/version.json map/version.json
git commit -m "chore(release): ${TAG}"

# Re-read commit SHA of release commit
FINAL_SHA=$(git rev-parse --short HEAD)

# Create annotated tag
git tag -a "${TAG}" -m "Release ${TAG}"

# 7. Push main and tags
echo "📦 Step 4/7: Pushing 'main' and '${TAG}' to GitHub..."
git push origin main
git push origin "${TAG}"

# 8. Create GitHub Release via gh CLI if available
echo "📝 Step 5/7: Creating GitHub Release..."
if command -v gh >/dev/null 2>&1; then
  if gh release create "${TAG}" --title "${TAG}" --generate-notes; then
    echo "✅ GitHub Release created successfully for ${TAG}"
  else
    echo "⚠️ Note: 'gh release create' returned non-zero, but Git tag was pushed to GitHub."
  fi
else
  echo "ℹ️ Note: 'gh' CLI not found. Git tag was pushed to GitHub."
fi

# 9. Deploy to production stack
echo "🚀 Step 6/7: Deploying to production stack on ${REMOTE_HOST}..."
ssh "$REMOTE_HOST" "export PATH='/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin:\$PATH'; cd ${PROD_DIR} && git pull && docker compose up -d --build --remove-orphans && docker compose restart wvmap_webserver"

# 10. Switch back to testing and synchronize
echo "🔄 Step 7/7: Syncing release back into 'testing' branch..."
git checkout testing
git merge main -m "Sync release ${TAG} back to testing"
git push origin testing

echo ""
echo "🎉 ==========================================================="
echo "🎉 RELEASE ${TAG} PUBLISHED & DEPLOYED SUCCESSFULLY!"
echo "🎉 ==========================================================="
echo "   Live Portal:  https://westville.app"
echo "   Live Map:     https://map.westville.app"
echo "   GitHub Tag:   https://github.com/Westville-Map/map-server-stack/releases/tag/${TAG}"
echo "   Active Branch: testing (ready for next development cycle)"
echo "🎉 ==========================================================="
