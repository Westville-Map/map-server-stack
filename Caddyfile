{$MAP_DOMAINS:map.westville.app:80} {
    # Enable Gzip and Zstd compression
    encode gzip zstd

    # HTTP Security Headers
    header {
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "frame-ancestors 'self' {$CSP_FRAME_ANCESTORS:https://map.westville.app https://www.westville.app https://westville.app};"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Static media assets: long TTL with background revalidation
    @staticAssets {
        path *.svg *.png *.jpg *.jpeg *.ico *.webp *.woff2 *.webmanifest
    }
    header @staticAssets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

    # Default caching policy: Revalidate everything else (HTML, GeoJSON, JS/CSS) via ETag
    @revalidate {
        not path *.svg *.png *.jpg *.jpeg *.ico *.webp *.woff2 *.webmanifest
    }
    header @revalidate Cache-Control "no-cache, must-revalidate"

    # Block compressed request bodies to protect upstream backend against decompression exploits (CVE-2026-111497)
    @compressedApiUpload {
        path /api/*
        header Content-Encoding *
    }
    respond @compressedApiUpload "Upload compression not supported" 415

    # Route API requests to the backend container
    reverse_proxy /api/* wvmap_backend:3000

    # Serve static files
    root * /var/www/map
    file_server
}

{$WEB_DOMAINS:westville.app:80, www.westville.app:80} {
    # Enable Gzip and Zstd compression
    encode gzip zstd

    # HTTP Security Headers
    header {
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "frame-ancestors 'self' {$CSP_FRAME_ANCESTORS:https://map.westville.app https://www.westville.app https://westville.app};"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Caching Policies:
    # 1. Service Worker: Never cache in HTTP layer
    @serviceWorker {
        path /sw.js
    }
    header @serviceWorker Cache-Control "no-cache, no-store, must-revalidate, max-age=0"

    # 2. Static media assets: long TTL with background revalidation
    @staticAssets {
        path *.svg *.png *.jpg *.jpeg *.ico *.webp *.woff2 *.webmanifest
    }
    header @staticAssets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

    # 3. Dynamic content: Revalidate HTML, subdirectories (/directory/, /festival/, /trash/), GeoJSON, and JS/CSS via ETag
    @revalidate {
        not path /sw.js
        not path *.svg *.png *.jpg *.jpeg *.ico *.webp *.woff2 *.webmanifest
    }
    header @revalidate Cache-Control "no-cache, must-revalidate"

    # Serve static files
    root * /srv/www
    file_server
}

