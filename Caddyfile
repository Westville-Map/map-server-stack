map.westville.app:80, map.westville.app:80 {
    # Enable Gzip and Zstd compression
    encode gzip zstd

    # HTTP Security Headers
    header {
        X-Content-Type-Options "nosniff"
        # X-Frame-Options "SAMEORIGIN"
        # Content-Security-Policy "frame-ancestors 'self' https://www.westville.app https://westville.app;"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Route API requests to the backend container
    reverse_proxy /api/* wvmap_backend:3000

    # Serve static files
    root * /var/www/map
    file_server
}

westville.app:80, www.westville.app:80 {
    # Enable Gzip and Zstd compression
    encode gzip zstd

    # HTTP Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Content-Security-Policy "frame-ancestors 'self' https://www.westville.app https://westville.app;"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Serve static files
    root * /srv/www
    file_server
}

